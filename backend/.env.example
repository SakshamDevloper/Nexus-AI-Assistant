# LLM Providers (at least one required)
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
MINIMAX_API_KEY=...

# Tool APIs
TAVILY_API_KEY=tvly-...
OPENWEATHER_API_KEY=...

# Database (optional — falls back to file-based storage)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/nexus-ai
MONGODB_DB=nexus-ai

# Cache (optional)
REDIS_URL=redis://localhost:6379

# Firebase Admin (required for auth)
FIREBASE_PROJECT_ID=nexus-ai-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nexus-ai-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
